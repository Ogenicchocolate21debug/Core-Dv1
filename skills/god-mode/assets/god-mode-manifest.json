{
  "name": "GOD MODE",
  "slug": "god-mode",
  "version": "1.1.1",
  "type": "hybrid",
  "modes": ["cloud", "local", "hybrid"],
  "source": {
    "repository": "https://github.com/Ogenicchocolate21debug/Core-Dv1",
    "chat_spec_date": "2026-08-27",
    "logo_source": "IMG_0172.jpeg"
  },
  "tool_families": [
    "workspace_*",
    "read_file/search_text/apply_patch",
    "git_status/git_diff/git_log",
    "project_dev/test/lint/typecheck/build",
    "process_*/shell/codex_run",
    "dom_cdp/accessibility/input_event",
    "vision/window",
    "office/clipboard/file_dialog",
    "screen_record/audio",
    "notification/scheduler",
    "web_fetch",
    "system_info/health"
  ],
  "invocation": ["Use $god-mode ...", "@GOD MODE ..."],
  "availability_status": [
    "READY_CLOUD",
    "READY_LOCAL",
    "READY_HYBRID",
    "CONNECTOR_REQUIRED",
    "LOCAL_BRIDGE_REQUIRED",
    "EXECUTION_SURFACE_REQUIRED",
    "CONFIGURATION_REQUIRED"
  ],
  "temporarily_disabled_controls": [
    "outbound-only-no-inbound-webhook",
    "absolute-hard-delete-ban",
    "absolute-secret-placement-ban",
    "fixed-120-word-final-limit",
    "absolute-force-push-history-rewrite-ban"
  ],
  "efficiency": {
    "default_max_final_words": null,
    "fixed_word_limit_enabled": false,
    "reuse_unchanged_state": true,
    "batch_independent_calls": true,
    "stop_after_verification": true
  },
  "persistence": {
    "absolute_hard_delete_ban_enabled": false,
    "absolute_force_push_ban_enabled": false,
    "absolute_rewrite_history_ban_enabled": false,
    "default_strategy": "append-or-version"
  },
  "network_policy": {
    "outbound_only_enabled": false,
    "no_inbound_webhook_enabled": false,
    "replacement_status": "OWNER_APPROVAL_REQUIRED"
  },
  "secret_policy": {
    "absolute_placement_ban_enabled": false,
    "replacement_status": "OWNER_APPROVAL_REQUIRED"
  }
}
